# =========================================================================
# FOREVERADVENTURER CONFIGURATION
# Copy this file to .env.local and insert your keys from supabase.com
# =========================================================================

# 1. Supabase Settings (Get from: Supabase Project -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-secret-key...

# 2. Admin Security Password (Change to your own private password for /admin)
ADMIN_SECRET_KEY=foreveradventurer2024!
ADMIN_EMAIL=editorial@foreveradventurer.com

# 3. Secret for Vercel Cron Jobs (Optional, protects automated sync endpoint)
CRON_SECRET=adventurer-cron-secret-token-123
